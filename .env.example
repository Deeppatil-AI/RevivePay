# Server Configuration
PORT=5000
NODE_ENV=development
AUTH_BYPASS_DEMO=true

# Frontend API Base URL (default: http://localhost:5000/api for local dev; set to deployed backend in production/Docker)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_BACKEND_URL=http://localhost:5000

# API Key required to mint signed merchant JWT tokens (POST /api/auth/token)
DEMO_API_KEY=your_secure_merchant_api_key_here

# Razorpay API Credentials (Test Mode)
VITE_RAZORPAY_KEY=rzp_test_sec_99481
RAZORPAY_KEY_ID=rzp_test_sec_99481
RAZORPAY_KEY_SECRET=rzp_test_secret_key_here
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_here

# JWT Auth Secret
JWT_SECRET=revivepay_jwt_secret_token_dev_2026

# SQLite Database File
DATABASE_PATH=./server/database/revivepay.sqlite
